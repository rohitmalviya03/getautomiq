# ---- App ----
NODE_ENV=development
HEALTH_PORT=4100

# ---- Redis (same instance growasy-api produces jobs to) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Database (same MySQL growasy-api owns; worker never migrates, only reads/writes) ----
DATABASE_URL="mysql://root:123456@localhost:3333/growasy"

# ---- Token encryption (MUST equal growasy-api's ENCRYPTION_KEY — 64 hex chars) ----
ENCRYPTION_KEY=a5b66fa36b430bd10c2c074ba9637965be0edf4f7d468a7910d0fe2ae3c833eb

# ---- Instagram Graph API (comment→DM automation execution) ----
META_GRAPH_API_VERSION=v20.0
INSTAGRAM_GRAPH_BASE=https://graph.instagram.com
WEBHOOK_PROCESSING_CONCURRENCY=10
AUTOMATION_EXECUTION_CONCURRENCY=5

# ---- Mail (SMTP transport used to actually send verification/reset/welcome emails) ----
MAIL_FROM="Growasy <no-reply@growasy.app>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ---- Frontend (used to build/validate links embedded in emails) ----
WEB_APP_URL=http://localhost:5173
