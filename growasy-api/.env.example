# ---- App ----
NODE_ENV=development
PORT=4000
API_PREFIX=api
API_VERSION=v1
CORS_ORIGINS=http://localhost:5173

# ---- Database ----
DATABASE_URL="mysql://growasy:growasy@localhost:3306/growasy"

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- JWT ----
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-long
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d

# ---- Password hashing ----
BCRYPT_SALT_ROUNDS=12

# ---- Email verification / reset tokens ----
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# ---- Rate limiting ----
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ---- Meta / Instagram OAuth (populate in Instagram Accounts module) ----
# Facebook App ID/Secret (Dashboard > App settings > Basic) — not used by the
# Instagram Login flow, kept for reference.
META_APP_ID=
META_APP_SECRET=
# Instagram App ID/Secret (Dashboard > Instagram > "API setup with Instagram Login").
# These drive the connect flow — different from the Facebook App ID/Secret above.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
META_REDIRECT_URI=http://localhost:5173/settings/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=change-me-webhook-verify-token
META_GRAPH_API_VERSION=v20.0
# Optional override of the OAuth scope list. Default is the minimal working set;
# add pages_manage_metadata here once your Meta app has it approved (enables
# automatic webhook subscription on connect).
META_OAUTH_SCOPES=

# ---- Object storage (AWS S3-compatible) ----
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=growasy-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---- Mail (used by growasy-worker to send verification/reset emails) ----
MAIL_FROM="Automiq <hello@getautomiq.online>"
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=

# ---- Frontend ----
WEB_APP_URL=http://localhost:5173

# ---- Token encryption (AES-256-GCM key for third-party access tokens at rest; 64 hex chars) ----
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ---- Razorpay (payments) ----
# Dashboard > Settings > API Keys (use test keys while testing: rzp_test_...)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard > Settings > Webhooks — set the secret you configure there.
# Webhook URL: https://<api-domain>/api/v1/billing/webhook  (event: order.paid)
# The /v1 is not optional: the route is API_PREFIX + Nest's URI version segment
# (API_VERSION=1 -> /v1), so /api/billing/webhook 404s and no payment activates.
RAZORPAY_WEBHOOK_SECRET=
