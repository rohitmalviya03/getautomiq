# =============================================================================
# Growasy / Automiq — PRODUCTION environment (single source of truth for the
# docker-compose stack). Copy to `.env` and fill in. This is the ONLY file you
# edit to deploy.
#
#   cp .env.example .env && nano .env
#
# The same .env is passed to both the API and the worker (each ignores the vars
# it doesn't use). NEVER commit the real .env — it's git-ignored.
#
# Generate strong secrets:
#   openssl rand -hex 32     # → JWT secrets (also fine as passwords)
#   openssl rand -hex 32     # → ENCRYPTION_KEY (must be exactly 64 hex chars)
# =============================================================================

# ---- Images / deploy --------------------------------------------------------
# Where images are pulled from in production (GitHub Container Registry).
# Leave as `growasy` to build locally with `docker compose build`.
IMAGE_REGISTRY=ghcr.io/your-github-username
IMAGE_TAG=latest

# ---- MySQL (internal only; compose builds DATABASE_URL from these) ----------
MYSQL_DATABASE=growasy
MYSQL_USER=growasy
# Use alphanumeric passwords (they are embedded in the DATABASE_URL).
MYSQL_PASSWORD=change_me_strong_db_password
MYSQL_ROOT_PASSWORD=change_me_strong_root_password

# ---- Redis (internal only; BullMQ broker) -----------------------------------
REDIS_PASSWORD=change_me_strong_redis_password

# ---- API: core --------------------------------------------------------------
API_PREFIX=api
API_VERSION=1
# Comma-separated origins allowed by CORS — your production web origin(s).
CORS_ORIGINS=https://your-domain.com
# Public URL of the web app (used to build links inside emails).
WEB_APP_URL=https://your-domain.com

# ---- API: auth / crypto (REQUIRED) ------------------------------------------
# Each JWT secret must be >= 32 chars. Use `openssl rand -hex 32`.
JWT_ACCESS_SECRET=change_me_at_least_32_characters_long_secret
JWT_REFRESH_SECRET=change_me_another_32_characters_long_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_REMEMBER_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=12
# AES-256-GCM key for Instagram token encryption. EXACTLY 64 hex chars.
# MUST be identical for API and worker (worker decrypts what API encrypted).
ENCRYPTION_KEY=change_me_to_64_hex_chars_openssl_rand_hex_32_output_here_0000

# ---- API: rate limiting -----------------------------------------------------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ---- API: token TTLs --------------------------------------------------------
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_TOKEN_TTL_MINUTES=60

# ---- Meta / Instagram (OAuth + webhooks) ------------------------------------
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Must exactly match the redirect URI registered in the Meta app.
META_REDIRECT_URI=https://your-domain.com/settings/instagram/callback
META_WEBHOOK_VERIFY_TOKEN=change_me_random_webhook_verify_token
META_GRAPH_API_VERSION=v20.0
META_OAUTH_SCOPES=instagram_business_basic,instagram_business_manage_messages,instagram_business_manage_comments
INSTAGRAM_GRAPH_BASE=https://graph.instagram.com
# MUST stay false in production (verifies X-Hub-Signature-256 on webhooks).
META_SKIP_WEBHOOK_SIGNATURE=false

# ---- Worker: queue concurrency ----------------------------------------------
WEBHOOK_PROCESSING_CONCURRENCY=10
AUTOMATION_EXECUTION_CONCURRENCY=5

# ---- Email (transactional SMTP — e.g. Brevo/Resend/SES) ---------------------
MAIL_FROM=Automiq <no-reply@your-domain.com>
SMTP_HOST=smtp.your-provider.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ---- Razorpay (payments) ----------------------------------------------------
# Going LIVE is purely configuration — no code change. The API endpoint and the
# Checkout script are the same in both modes; the key is what selects the mode.
#
#  1. Razorpay Dashboard: finish KYC / account activation, then flip the
#     dashboard's mode switch to LIVE (test and live have separate everything).
#  2. Settings > API Keys > Generate Live Key  ->  the id starts with rzp_live_.
#  3. Settings > Webhooks > Add New Webhook (in LIVE mode — the test-mode webhook
#     and its secret do NOT carry over):
#        URL     https://your-domain.com/api/v1/billing/webhook
#        Events  order.paid   (required — this is what activates a plan)
#                payment.failed  (optional, logged only)
#     The /v1 is not optional: the route is API_PREFIX + Nest's URI version
#     segment, so /api/billing/webhook 404s and no payment ever activates.
#  4. Put the three values below, then recreate the API container so it picks up
#     the new env:  docker compose up -d --force-recreate api worker
#
# If these are left blank the app does not error — GET /api/v1/billing/config
# reports enabled:false and the UI hides the pay button. So an empty value here
# looks exactly like "payments are switched off".
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Object storage (OPTIONAL — only if you enable S3 uploads) --------------
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
